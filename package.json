{
  "name": "mad-dog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build wasm/mad-dog-sim --target web --out-dir ../../src/sim/wasm/pkg --release",
    "ensure:wasm": "test -f src/sim/wasm/pkg/mad_dog_sim.js || npm run build:wasm",
    "dev": "npm run ensure:wasm && vite",
    "build": "npm run build:wasm && tsc -b && vite build",
    "build:pages": "GITHUB_PAGES=true npm run build",
    "check:wasm": "npm run build:wasm && node scripts/wasm-check.ts",
    "bench:factorization": "npm run build:wasm && node scripts/factorization-bench.ts",
    "bench:universe": "npm run build:wasm && node scripts/universe-bench.ts",
    "bench:geometry": "npm run build:wasm && node scripts/geometry-bench.ts",
    "bench:time": "npm run build:wasm && node scripts/time-bench.ts",
    "bench:causality": "npm run build:wasm && node scripts/causality-bench.ts",
    "sweep:mass": "npm run build:wasm && node scripts/mass-sweep.ts",
    "check:falsification": "npm run ensure:wasm && node scripts/falsification-check.ts",
    "sweep:scattering": "npm run build:wasm && node scripts/scattering-sweep.ts",
    "sweep:refinement": "npm run build:wasm && node scripts/refinement-adaptive.ts",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
